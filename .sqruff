[sqruff]
dialect = sqlite
templater = raw
max_line_length = 100
# LT01 (layout.spacing): keep column-type alignment in CREATE TABLE.
# LT02 (layout.indent): sqruff's SQLite parser flattens BEGIN...END trigger
#   bodies, so its indent autofix corrupts them - leave indent to the author.
exclude_rules = ambiguous.column_count, layout.spacing, layout.indent

[sqruff:indentation]
tab_space_size = 2
indent_unit = space

[sqruff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqruff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower

[sqruff:rules:capitalisation.functions]
extended_capitalisation_policy = upper

[sqruff:rules:capitalisation.literals]
capitalisation_policy = upper

[sqruff:rules:capitalisation.types]
extended_capitalisation_policy = upper

[sqruff:rules:convention.not_equal]
preferred_not_equal_style = c_style

[sqruff:rules:layout.long_lines]
ignore_comment_lines = true
